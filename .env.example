# ============================================================
# PBI CLI Chat - Environment Configuration
# ============================================================

# ── Cloud Mode ──────────────────────────────────────────────
# Set to "true" when running in Cloudera AI Workbench
# Set to "false" for local development
CLOUD_MODE=false

# ── Logging ─────────────────────────────────────────────────
# Backend: sqlite | postgres | file
LOG_BACKEND=sqlite
LOG_SQLITE_PATH=./logs/usage.db

# PostgreSQL (if LOG_BACKEND=postgres)
# LOG_POSTGRES_HOST=localhost
# LOG_POSTGRES_PORT=5432
# LOG_POSTGRES_DB=pbi_cli_logs
# LOG_POSTGRES_USER=admin
# LOG_POSTGRES_PASSWORD=secret

# ── Authentication (Optional) ───────────────────────────────
# Backend: none | ldap | oauth
AUTH_BACKEND=none

# LDAP/Active Directory (if AUTH_BACKEND=ldap)
# AUTH_LDAP_SERVER=ldap://ldap.company.com
# AUTH_LDAP_PORT=389
# AUTH_LDAP_BASE_DN=dc=company,dc=com
# AUTH_LDAP_USER_DN=ou=users,dc=company,dc=com

# ── Batch Processing ────────────────────────────────────────
# Maximum concurrent batch operations
BATCH_MAX_WORKERS=4

# Batch timeout (seconds)
BATCH_TIMEOUT=300

# ── Power BI Configuration ──────────────────────────────────
# Default PBIP search paths (semicolon-separated)
# PBIP_SEARCH_PATHS=C:\Reports;D:\PowerBI Projects

# ── Feature Flags ───────────────────────────────────────────
# Enable mass mode by default
ENABLE_MASS_MODE=true

# Enable usage analytics dashboard
ENABLE_ANALYTICS=true
